# The one environment file for local development, read by Docker Compose and
# its containers and by Nx. Copy it to .env (not committed) before the first
# start, in every way of running the project, and change what you need there.
# Local development values only; in the cluster they come from 1Password.

# Users of the shared databases in Docker. Local development only.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
VALKEY_USER=app
VALKEY_PASSWORD=app

# Ports of the shared services in Docker. Change one when another project
# already uses it.
POSTGRES_PORT=5432
ADMINER_PORT=8080
VALKEY_PORT=6379
REDISINSIGHT_PORT=5540

# Ports of one instance of the apps: the block from 41000 + 10 x slot, where
# the main checkout is slot 0. These variables get the offsets 0, 1, 2, … in
# this order. Each app takes its ports from here, never from project.json;
# see docs/development/adding-an-app.md.
# per-instance-ports
WEB_PORT=41000
API_PORT=41001
STORYBOOK_PORT=41002
API_DEBUG_PORT=41003
# /per-instance-ports
# The Nx projects an isolated instance runs with `nx serve`, each listening
# on its <PROJECT>_PORT above, and the Nx targets it runs once when created.
INSTANCE_APPS=api,web,storybook
INSTANCE_SETUP=api:migrate,api:seed
# How many isolated instances may exist besides the main checkout, and how
# many ports each block has. See docs/development/setup.md#instances.
INSTANCE_LIMIT=3
INSTANCE_PORT_BLOCK=10

# Databases of this instance, on the shared servers.
POSTGRES_DB=app
VALKEY_DB=0

# API, which listens on API_PORT.
# fatal, error, warn, log (alias info), debug or verbose; info in production.
LOG_LEVEL=debug
# Media files; /app/media in Docker and in the cluster.
MEDIA_DIR=tmp/media
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
REDIS_URL=redis://${VALKEY_USER}:${VALKEY_PASSWORD}@localhost:${VALKEY_PORT}/${VALKEY_DB}
# Swagger at /api/docs; off in production.
SWAGGER_ENABLED=true
# Signs access tokens. Required.
JWT_SECRET=local-dev-jwt-secret
# The test account the seed command writes.
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=admin

# Web dev server: where it sends /api.
API_PROXY_TARGET=http://localhost:${API_PORT}

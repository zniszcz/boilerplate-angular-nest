{
  "name": "boilerplate-angular-nest",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.8.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "nx run-many -t serve --projects=api,web",
    "storybook": "nx run storybook:storybook",
    "build": "nx run-many -t build",
    "contracts:generate": "nx build api && node dist/apps/api/openapi.js tmp/openapi.json && openapi-typescript tmp/openapi.json -o libs/shared/contracts/src/lib/api.generated.ts && prettier --write libs/shared/contracts/src/lib/api.generated.ts",
    "contracts:check": "pnpm contracts:generate && git diff --exit-code libs/shared/contracts",
    "lint": "nx run-many -t lint",
    "architecture": "depcruise apps libs --config .dependency-cruiser.cjs",
    "versions": "syncpack lint",
    "docs:generate": "node scripts/docs.mjs generate",
    "docs:check": "node scripts/docs.mjs check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@jsverse/transloco": "8.4.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "@ng-icons/core": "32.5.0",
    "@ng-icons/lucide": "32.5.0",
    "@ngrx/signals": "22.0.1",
    "@spartan-ng/brain": "1.6.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.1",
    "@angular-devkit/core": "22.2.1",
    "@angular-devkit/schematics": "22.2.1",
    "@angular/animations": "22.2.1",
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/language-service": "22.2.1",
    "@angular/platform-browser-dynamic": "22.2.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@nx/angular": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/nest": "23.2.1",
    "@nx/node": "23.2.1",
    "@nx/storybook": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@schematics/angular": "22.2.1",
    "@spartan-ng/cli": "1.6.0",
    "@storybook/angular": "10.6.1",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/postcss": "4.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@typescript-eslint/utils": "8.71.0",
    "angular-eslint": "22.5.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-rxjs-x": "1.0.6",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "nx": "23.2.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "storybook": "10.6.1",
    "syncpack": "15.3.3",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "5.2.6"
  }
}

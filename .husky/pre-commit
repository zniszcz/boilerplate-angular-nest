# Exact versions only (docs/adr/0004-exact-versions.md). Blocks the commit,
# because a range in package.json makes installs differ between machines.
# Fix with: pnpm exec syncpack fix
if ! command -v pnpm >/dev/null 2>&1; then
  echo "versions: skipped, pnpm not found. Run 'nvm use' and 'corepack enable'." >&2
  exit 0
fi
if git diff --cached --name-only | grep -q '^package\.json$'; then
  pnpm versions
fi

# Every agent skill gets its link for Claude Code, and links to removed
# skills go (docs/adr/0028-agent-skills.md).
if pnpm --silent skills:link | grep -qE '^(Linked|Removed)'; then
  git add -A .claude/skills
fi

# Generated lists in the docs (projects, concepts, ADR index, skills) follow
# the repository: regenerate them and add them to this commit.
if pnpm --silent docs:generate | grep -q '^Updated'; then
  git add docs/README.md docs/adr/README.md .agents/skills/README.md
fi

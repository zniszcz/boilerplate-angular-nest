# Conventional Commits check. It only warns and never blocks the commit.
if ! command -v pnpm >/dev/null 2>&1; then
  echo "commitlint: skipped, pnpm not found. Run 'nvm use' and 'corepack enable'." >&2
elif ! pnpm exec commitlint --edit "$1"; then
  echo "commitlint: the check failed, see the output above." >&2
  echo "commitlint: the commit was created anyway. Amend it with: git commit --amend" >&2
fi
exit 0

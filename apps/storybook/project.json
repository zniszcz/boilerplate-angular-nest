{
  "name": "storybook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/storybook/.storybook",
  "tags": ["scope:web", "type:app"],
  "targets": {
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook",
        "configDir": "apps/storybook/.storybook",
        "tsConfig": "apps/storybook/tsconfig.json",
        "styles": ["apps/web/src/styles.css"],
        "experimentalZoneless": true,
        "compodoc": false
      }
    },
    "start": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "options": {
        "browserTarget": "storybook:build-storybook",
        "configDir": "apps/storybook/.storybook",
        "tsConfig": "apps/storybook/tsconfig.json",
        "styles": ["apps/web/src/styles.css"],
        "experimentalZoneless": true,
        "compodoc": false
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run storybook:start --port=$STORYBOOK_PORT"
      },
      "metadata": {
        "description": "Storybook on STORYBOOK_PORT from the root .env."
      }
    }
  }
}

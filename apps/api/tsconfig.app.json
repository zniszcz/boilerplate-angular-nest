{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "moduleResolution": "bundler",
    // Helpers are inlined. Nx does not see a tslib import, so it would leave
    // tslib out of the generated package.json and the image would not start.
    "importHelpers": false
  },
  "include": ["src/**/*.ts"]
}

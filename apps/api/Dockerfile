# Build context is the repository root: docker build -f apps/api/Dockerfile .

FROM node:24.21.0-slim AS base
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    HUSKY=0 \
    NX_NO_CLOUD=true
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# Local development. Source code is synced by docker compose watch.
FROM deps AS dev
# Nx disables its daemon inside Docker, but file watching needs it.
ENV NX_DAEMON=true
COPY . .
# The port is API_PORT from the root .env, which compose.yaml passes in.
CMD ["pnpm", "nx", "serve", "api"]

# Production build. Nx writes main.js, package.json and a pruned lockfile.
FROM deps AS build
COPY . .
RUN pnpm nx build api

# Runtime dependencies installed on Alpine, so native modules match musl.
# The lockfile generated by Nx lacks the pnpm entry that pnpm checks against
# packageManager, so the field is removed and the same pnpm version is called
# explicitly.
FROM node:24.21.0-alpine3.23 AS prod-deps
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app
COPY --from=build /app/dist/apps/api/package.json /app/dist/apps/api/pnpm-lock.yaml /app/dist/apps/api/pnpm-workspace.yaml ./
RUN PM="$(npm pkg get packageManager | tr -d '"')" \
 && npm pkg delete packageManager \
 && corepack "$PM" install --prod --frozen-lockfile

# Image deployed to the cluster: built code and runtime dependencies only.
FROM node:24.21.0-alpine3.23 AS prod
ENV NODE_ENV=production \
    PORT=3000 \
    MEDIA_DIR=/app/media
WORKDIR /app
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/dist/apps/api ./
# Owned by node, so a fresh volume mounted here is writable without root.
RUN mkdir -p /app/media && chown node:node /app/media
USER node
EXPOSE 3000
CMD ["node", "main.js"]

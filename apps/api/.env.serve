# Defaults for `nx serve api` outside Docker. Local development values only.
# Put personal overrides in the root .env file, which is not committed.
PORT=3000
LOG_LEVEL=debug
MEDIA_DIR=tmp/media
DATABASE_URL=postgres://app:app@localhost:${POSTGRES_PORT:-5432}/app
REDIS_URL=redis://app:app@localhost:${VALKEY_PORT:-6379}
SWAGGER_ENABLED=true
# Local development values only. In the cluster they come from 1Password.
JWT_SECRET=local-dev-jwt-secret
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=admin

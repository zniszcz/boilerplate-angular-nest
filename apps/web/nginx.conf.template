# Serves the built Angular app. Requests to /api go to the backend through
# the cluster ingress, so nginx does not proxy them.
# A template: at start nginx puts environment variables in, so ${STORYBOOK_ENABLED}
# comes from the container. nginx's own variables, such as $uri, stay as they are.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Security headers for every response. `merge` keeps them in locations
    # that add their own headers; by default nginx would drop them there.
    add_header_inherit merge;

    # Only our own files may run or load.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    # Example: the same policy with Google Fonts allowed. The stylesheet comes
    # from fonts.googleapis.com, the font files from fonts.gstatic.com.
    # add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    # Browsers ignore it over plain HTTP, so it is safe locally.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Unknown paths fall back to index.html, so Angular routes work on reload.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Built files have hashed names and never change.
    location ~* \.(?:js|css|woff2?|ico|svg|png|jpg|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html must be fresh, so a new deployment is picked up at once.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    # Storybook, only where STORYBOOK_ENABLED=true, like Swagger in the API.
    # Never on production. Storybook needs inline scripts and runs stories in
    # an iframe, so it gets its own, looser headers instead of the ones above.
    set $storybook_enabled "${STORYBOOK_ENABLED}";
    # ^~ wins over the regex location for .js and .css files above.
    location ^~ /storybook/ {
        if ($storybook_enabled != "true") {
            return 404;
        }
        alias /usr/share/nginx/storybook/;
        add_header_inherit off;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Cache-Control "no-cache" always;
    }
}

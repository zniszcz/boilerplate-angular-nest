{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@boilerplate/contracts": ["./libs/shared/contracts/src/index.ts"],
      "@boilerplate/api-users": ["./libs/api/users/src/index.ts"],
      "@boilerplate/api-access": ["./libs/api/access/src/index.ts"],
      "@boilerplate/api-authentication": [
        "./libs/api/authentication/src/index.ts"
      ],
      "@boilerplate/api-responses": ["./libs/api/responses/src/index.ts"],
      "@boilerplate/web-auth": ["./libs/web/auth/src/index.ts"],
      "@boilerplate/web-ui": ["./libs/web/ui/src/index.ts"],
      "@boilerplate/web-home": ["./libs/web/home/src/index.ts"],
      "@boilerplate/web-i18n": ["./libs/web/i18n/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
